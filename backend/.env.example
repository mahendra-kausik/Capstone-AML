RESEARCH_ROOT=/Users/you/Desktop/capstone/Capstone-AML

# --- Option A: Local dev (default) — SQLite, no Postgres needed ---
# DATABASE_URL=sqlite:///./aml_platform.db

# --- Option B: Docker Postgres ---
# DATABASE_URL=postgresql://aml:aml_secret@localhost:5432/aml_platform

JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000
DEBUG=true
SEED_DEMO_USERS=true

# Demo accounts (when SEED_DEMO_USERS=true):
# admin@example.com / demoaml2024
# analyst@example.com / demoaml2024
# viewer@example.com / demoaml2024
