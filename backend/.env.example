RESEARCH_ROOT=/Users/you/Desktop/capstone/Capstone-AML

# --- Option A: Local dev (default) — SQLite, no Postgres needed ---
# Leave DATABASE_URL unset, or explicitly:
# DATABASE_URL=sqlite:///./aml_platform.db

# --- Option B: Docker Postgres (start first: docker compose up postgres -d) ---
# DATABASE_URL=postgresql://aml:aml_secret@localhost:5432/aml_platform

JWT_SECRET=generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000
DEBUG=true
