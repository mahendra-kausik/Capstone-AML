# AML Intelligence Platform — Environment Configuration
# Copy to .env and fill in production values

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=aml
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
POSTGRES_DB=aml_platform
DATABASE_URL=postgresql://aml:change-me-use-openssl-rand-hex-32@postgres:5432/aml_platform

# ── Security ──────────────────────────────────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=7

# ── Application ──────────────────────────────────────────
DEBUG=false
SEED_DEMO_USERS=true
CORS_ORIGINS=http://localhost:3000

# ── ML Artifacts ─────────────────────────────────────────
RESEARCH_ROOT=/research

# ── Frontend ─────────────────────────────────────────────
# Leave unset for same-origin proxy via nginx/Next.js rewrites
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_PROXY_TARGET=http://backend:8000

# ── Demo Accounts (when SEED_DEMO_USERS=true) ────────────
# admin@example.com / demoaml2024
# analyst@example.com / demoaml2024
# viewer@example.com / demoaml2024
